# Postgres connection (docker compose up -d db)
DATABASE_URL=postgres://provenant:provenant@localhost:5432/provenant
# Used by `npm test`; tables are truncated between tests
TEST_DATABASE_URL=postgres://provenant:provenant@localhost:5432/provenant_test
# Show demo connector data (always flagged in the UI)
ENABLE_DEMO_SOURCE=true
# ATS boards to ingest, as provider:token from src/sources/boards.json (empty = none). See docs/sources.md.
ATS_BOARDS=
# Path to a Job Bank records file (assumed shape, see src/sources/jobbank). Empty = disabled.
JOBBANK_FIXTURE=
# How often the worker rechecks freshness (cron)
RECHECK_CRON=15 * * * *
# User-Agent sent to any source we fetch from
FETCH_USER_AGENT=ProvenantBot/0.1 (+https://example.invalid/bot)
# Phase 2 only: expose /admin without auth in development. Ignored in production.
ADMIN_DEV_OPEN=false
